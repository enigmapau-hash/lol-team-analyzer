{
  "name": "lol-team-analyzer",
  "version": "0.4.0-alpha",
  "private": true,
  "description": "Mini app de League of Legends basada en la pestaña Composición del Excel.",
  "type": "commonjs",
  "scripts": {
    "audit:excel": "node tools/check-workbook.cjs \"Draft Pool.xlsx\"",
    "audit:excel:report": "node tools/check-workbook.cjs \"Draft Pool.xlsx\" > workbook-report.json",
    "audit:composition": "node tools/audit-composition.cjs \"Draft Pool.xlsx\" tests/cases.json",
    "extract:workbook": "node tools/extract-workbook.cjs \"Draft Pool.xlsx\" draft-pool.json",
    "extract:workbook:stdout": "node tools/extract-workbook.cjs \"Draft Pool.xlsx\"",
    "validate:cases": "node tools/validate-cases.cjs",
    "generate:cases": "node tools/generate-cases-from-workbook.cjs draft-pool.json tests/cases.json",
    "report:cases": "node tools/report-cases.cjs",
    "audit:stage1": "npm run audit:excel && npm run audit:composition",
    "audit:stage1:full": "npm run audit:excel && npm run audit:composition",
    "version:sync": "node tools/bump-version.cjs"
  },
  "devDependencies": {
    "xlsx": "^0.18.5"
  }
}
